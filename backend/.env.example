# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (same as Node.js project)
DATABASE_URL=postgres://YOUR_USER@localhost:5432/publive_tester
DATABASE_SSL=false

# AI pipeline
OPENAI_API_KEY=your_openai_api_key_here

# Dashboard under test
DASHBOARD_URL=https://betadashboard.thepublive.com/v2
DASHBOARD_EMAIL=your-email@example.com
DASHBOARD_PASSWORD=your-password
# DASHBOARD_SESSION=your-session-cookie-value

# Frontend CORS origin
FRONTEND_URL=http://localhost:5173

# New Relic (Python agent) — license key is read from this env var, not from
# the committed backend/newrelic.ini, so it never ends up in a git diff or image layer.
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# Path to the project root (defaults to this directory, no need to change)
# PLAYWRIGHT_PROJECT_ROOT=.
